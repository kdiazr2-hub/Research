# SQLite (default for local-first). For Postgres later:
# DATABASE_URL="postgresql://user:pass@localhost:5432/research"
DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Local filesystem roots for PDFs, analysis/ de-ID CSVs, notebooks, export scratch
STORAGE_ROOT="./storage"
EXPORT_ROOT="./exports"

# Salt for hashing PHI values on de-ID export (change in real deployments)
DEID_SALT="local-deid-salt"
