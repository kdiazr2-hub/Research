// M0 spike: SQLite for local-first. Swap provider to postgresql + DATABASE_URL for Postgres later.
// String constants stand in for enums (SQLite has no Prisma enum support in v5).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  locale       String       @default("es")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  auditLogs    AuditLog[]
  notes        Note[]
}

model Project {
  id                  String       @id @default(cuid())
  name                String
  description         String       @default("")
  /// LITERATURE | DATA | ANALYSIS | WRITING
  status              String       @default("LITERATURE")
  /// CARE | PRISMA | CONSORT | STROBE | SPIRIT | STARD | OTHER
  reportingGuideline  String       @default("OTHER")
  /// e.g. CARE 2013, PRISMA 2020
  reportingGuidelineVersion String @default("n/a")
  /// NONE | PHI | PHI_IMAGING
  phiType             String       @default("NONE")
  consentDocumented   Boolean      @default(false)
  consentDocUrl       String?
  legalBasis          String?
  retentionDestroyAt  DateTime?
  analysisDeidDefault Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  memberships         Membership[]
  auditLogs           AuditLog[]
  checklistItems      ChecklistItem[]
  references          Reference[]
  notes               Note[]
  manuscript          Manuscript?
}

/// Interactive EQUATOR checklist progress for a project.
model ChecklistItem {
  id        String   @id @default(cuid())
  projectId String
  itemKey   String
  checked   Boolean  @default(false)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, itemKey])
  @@index([projectId])
}

model Membership {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  /// OWNER | INVESTIGATOR | COLLABORATOR | ANALYST | VIEWER
  role           String   @default("VIEWER")
  canViewPhi     Boolean  @default(false)
  canViewImaging Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  projectId String?
  action    String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Bibliographic item in a project library (BibTeX/RIS import; no Zotero sync in MVP).
model Reference {
  id          String   @id @default(cuid())
  projectId   String
  citeKey     String
  title       String   @default("")
  authors     String   @default("")
  year        String   @default("")
  journal     String   @default("")
  doi         String   @default("")
  url         String   @default("")
  abstract    String   @default("")
  /// article | book | inproceedings | misc | …
  entryType   String   @default("article")
  tags        String   @default("")
  bibtexRaw   String   @default("")
  /// Relative path under STORAGE_ROOT (local filesystem for MVP)
  pdfPath     String?
  pdfFileName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes       Note[]

  @@unique([projectId, citeKey])
  @@index([projectId])
}

/// Note linked to a reference (optional page/highlight stubs for MVP).
model Note {
  id            String    @id @default(cuid())
  projectId     String
  referenceId   String
  authorId      String?
  title         String    @default("")
  body          String    @default("")
  /// Optional PDF page stub (e.g. "12")
  pageStub      String    @default("")
  /// Optional highlight quote stub
  highlightStub String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reference     Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  author        User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([referenceId])
}

/// One Markdown manuscript draft per project, seeded from EQUATOR section outline.
model Manuscript {
  id        String   @id @default(cuid())
  projectId String   @unique
  title     String   @default("")
  markdown  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
